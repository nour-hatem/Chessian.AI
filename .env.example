# Example environment variables for Chessian.AI
# Copy this file to .env and fill in real values.

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chessian

# Stockfish engine path
STOCKFISH_PATH=/usr/bin/stockfish
STOCKFISH_DEPTH=20

# LLM API Keys (add your keys here)
ANTHROPIC_API_KEY=your-anthropic-key-here
GROQ_API_KEY=your-groq-key-here

# Lichess API token (optional — for higher rate limits)
LICHESS_API_TOKEN=your-lichess-token-here

# Application settings
DEBUG=true
SECRET_KEY=dev-secret-change-in-production
